# Use mock for deterministic guide replies or live for OpenAI-generated guide replies.
NEXT_PUBLIC_AI_MODE=mock

# A server-side OpenAI key is required for conversation-specific report analysis.
# Put the real value only in .env.local or a deployment secret; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_ANALYSIS_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
